        <td class="when">n=22, Sep 2026</td>
      </tr>
      <tr>
        <th scope="row">Rereading it with a second model</th>
        <td>14.4–22.8 s</td>
        <td class="when">Sep 2026</td>
      </tr>
      <tr>
        <th scope="row">Drawing one page</th>
