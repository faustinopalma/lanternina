+inline String resolveMdnsUrl(const String &url) {
+  int schemeEnd = url.indexOf("://");
+  if (schemeEnd < 0) return url;
+
+  int hostStart = schemeEnd + 3;
+  int hostEnd = url.indexOf('/', hostStart);
+  if (hostEnd < 0) hostEnd = url.length();
+  int portStart = url.indexOf(':', hostStart);
+  if (portStart >= 0 && portStart < hostEnd) hostEnd = portStart;
+
+  String host = url.substring(hostStart, hostEnd);
+  if (!host.endsWith(".local")) return url;
+
+  String mdnsName = host.substring(0, host.length() - 6);
+  IPAddress address = MDNS.queryHost(mdnsName.c_str(), 3000);
+  if (address == IPAddress()) {
+    Log_error("mDNS could not resolve %s", host.c_str());
+    return url;
+  }
+
+  String resolved = url;
+  resolved = resolved.substring(0, hostStart) + address.toString() + resolved.substring(hostEnd);
+  Log_info("mDNS resolved %s", host.c_str());
+  return resolved;
+}
