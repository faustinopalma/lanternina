diff --git a/src/display.cpp b/src/display.cpp
index 1d2c625..320af36 100644
--- a/src/display.cpp
+++ b/src/display.cpp
@@ -1901,8 +1901,69 @@ uint8_t *buffer;
  * @param message_type type of message that will show on the screen
  * @return none
  */
+#ifdef LANTERNINA_DISPLAY
+void display_show_lanternina(const char *first, const char *second, const char *third)
+{
+    if (bbep.allocBuffer(false) != BBEP_SUCCESS)
+        return;
+    bbep.fillScreen(BBEP_WHITE);
+    bbep.setFont(nicoclean_8);
+    bbep.setTextColor(BBEP_BLACK, BBEP_WHITE);
+    const char *lines[] = {"LANTERNINA", first, second, third};
+    for (int line = 0; line < 4; ++line)
+    {
+        BB_RECT bounds;
+        bbep.getStringBox(lines[line], &bounds);
+        bbep.setCursor((bbep.width() - bounds.w) / 2, 120 + line * 64);
+        bbep.print(lines[line]);
+    }
+    display_update_epaper(REFRESH_FULL, true, true, PLANE_0);
+    bbep.freeBuffer();
+}
+
+static void display_lanternina_message(MSG message_type)
+{
+    switch (message_type)
+    {
+    case WIFI_FAILED:
+    case WIFI_WEAK:
+    case WIFI_RETRY_LIMIT:
+        return;
+    case WIFI_CONNECT:
+    case WIFI_RESET_CONFIRM:
+    case CAPTIVE_WIFI_TIMEOUT:
+    case MAC_NOT_REGISTERED:
+    case API_SETUP_FAILED:
+        display_show_lanternina("Collega il display all'hub via USB.", "", "");
+        break;
+    case FW_UPDATE:
+        display_show_lanternina("Aggiornamento in corso.", "", "");
+        break;
+    case FW_UPDATE_SUCCESS:
+        display_show_lanternina("Aggiornamento completato.", "Riavvio in corso.", "");
+        break;
+    case FW_UPDATE_FAILED:
+    case API_FIRMWARE_UPDATE_ERROR:
+        display_show_lanternina("Aggiornamento da completare.",
+                                "Collega il display all'hub via USB.", "");
+        break;
+    case NONE:
+        display_show_lanternina("Collegamento in corso.", "", "");
+        break;
+    default:
+        display_show_lanternina("Contenuto non disponibile.",
+                                "Riprovo automaticamente.", "");
+        break;
+    }
+}
+#endif
