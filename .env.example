# Lanternina — local configuration template.
# Copy to `.env` (gitignored) and fill in. Nothing here is read from the network.

# ── Sealing keys ─────────────────────────────────────────────────────────────
# These make the safety and approval guarantees real rather than aspirational:
# the content-safety gate signs what it screened, the approval ledger signs what
# the parent greenlit, and the delivery boundary verifies both before anything
# is shown. Two DIFFERENT random keys — sharing one would let the safety gate
# mint approvals.
#
#   python -c "import secrets; print(secrets.token_hex(32))"
#
# Rotating them invalidates every existing approval, which is the correct
# behaviour: the parent re-approves rather than inheriting unverifiable state.
LANTERNINA_SAFETY_KEY=
LANTERNINA_APPROVAL_KEY=

# ── Azure AI Foundry (language + vision) ─────────────────────────────────────
# Entra ID only. There is no API-key code path: on the mini-PC use a service
# principal, on Azure compute a managed identity.
LANTERNINA_FOUNDRY_ENDPOINT=https://<your-foundry-account>.cognitiveservices.azure.com/
LANTERNINA_FOUNDRY_DEPLOYMENT=
LANTERNINA_FOUNDRY_API_VERSION=2024-12-01-preview

AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# ── Azure AI Content Safety ──────────────────────────────────────────────────
# The chokepoint every generated output passes. If this is unreachable the
# router must fall back to pre-approved cached content — never to unscreened
# generation.
LANTERNINA_CONTENT_SAFETY_ENDPOINT=

# ── Local model (offline path) ───────────────────────────────────────────────
# TODO(hackathon): pick a runtime. Empty means the LOCAL_SLM tier is skipped and
# the ladder degrades straight from cloud to cached content.
LANTERNINA_LOCAL_MODEL_PATH=

# ── Local storage ────────────────────────────────────────────────────────────
# Everything the running system writes: the approval ledger, session records and
# rectified page crops. Gitignored. Keep it off any synced folder.
LANTERNINA_DATA_DIR=./data

# ── Parent panel ─────────────────────────────────────────────────────────────
# Bind to the LAN only. Never expose this to the internet: it holds pending
# proposals and the scanned pages.
LANTERNINA_PANEL_HOST=127.0.0.1
LANTERNINA_PANEL_PORT=8080
# Random string used to sign the parent's session cookie.
LANTERNINA_PANEL_SESSION_SECRET=

LANTERNINA_LOG_LEVEL=INFO
