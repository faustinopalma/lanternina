[Unit]
Description=A new picture as often as the parent asked, while the house is awake

[Timer]
# Once a minute, because the spacing is the parent's to choose to the minute: an hourly
# timer cannot honour thirteen. A run with nothing to ask touches no network at all — it
# decides from the rhythm the last picture brought back — so the fine timer costs nothing
# and the panel's API is left to scale to zero.
OnCalendar=*:*:00
AccuracySec=10s
Persistent=true

[Install]
WantedBy=timers.target
