[Unit]
Description=Look for an afternoon to begin, and for a parent asking for one now

[Timer]
# Every minute. It was ten until 25 August 2026, and ten is still the right spacing for
# the scheduled look: the hour an afternoon may begin is a threshold, not an appointment.
# What changed is that the parent can press "begin one now" in the panel, and the panel
# has no way to reach the house — so the wait after a press is exactly this interval, and
# ten minutes of it is a button that feels broken.
#
# What it costs, measured on this hub: 1.2 s of CPU per run, so about 2% of one core, and
# two small requests to the panel. Neither is new work for the cloud: `pull_picture` was
# already asking the same panel for the same standing request once a minute, so nothing
# was scaling to zero between these runs anyway.
OnCalendar=*:0/1:00
AccuracySec=15s
Persistent=true

[Install]
WantedBy=timers.target
