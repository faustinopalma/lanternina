[Unit]
Description=Report display status to the panel, and look at the network

[Timer]
# A minute, since 25 August 2026. Five was far more often than a fault needs to surface,
# and it was also how long a parent waited after plugging a printer in — and how long an
# id card took to appear on a wall they were standing in front of. It costs one request to
# the panel and one mDNS sweep of the local network; neither reaches a model, so the
# monthly limit does not see it.
OnBootSec=2min
OnUnitActiveSec=1min
AccuracySec=10s

[Install]
WantedBy=timers.target
