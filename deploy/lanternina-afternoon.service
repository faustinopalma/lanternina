[Unit]
Description=Begin an afternoon, if this is a day and an hour the parent chose
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=fausto
Group=lanternina
EnvironmentFile=/etc/lanternina/trmnl-byos.env
EnvironmentFile=/etc/lanternina/panel.env
EnvironmentFile=-/etc/lanternina/scanner.env
EnvironmentFile=/etc/lanternina/experience.env
Environment=PYTHONDONTWRITEBYTECODE=1
WorkingDirectory=/opt/lanternina
ExecStart=/usr/bin/python3 -m devices.afternoon
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadOnlyPaths=/opt/lanternina
ReadWritePaths=/var/lib/lanternina/state
